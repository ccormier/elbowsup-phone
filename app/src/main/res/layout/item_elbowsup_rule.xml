<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/elbowsup_rule_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/elbowsup_rule_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/elbowsup_rule_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:textSize="@dimen/normal_text_size" />
    </LinearLayout>

    <org.fossify.commons.views.MyMaterialSwitch
        android:id="@+id/elbowsup_rule_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/elbowsup_rule_enabled" />

    <ImageView
        android:id="@+id/elbowsup_rule_up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/ripple_background"
        android:contentDescription="@string/elbowsup_rule_move_up"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_chevron_up_vector" />

    <ImageView
        android:id="@+id/elbowsup_rule_down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/ripple_background"
        android:contentDescription="@string/elbowsup_rule_move_down"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_chevron_down_vector" />
</LinearLayout>
