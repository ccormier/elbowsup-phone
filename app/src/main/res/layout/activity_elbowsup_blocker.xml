<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/elbowsup_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/elbowsup_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/elbowsup_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/elbowsup_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/elbowsup_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/elbowsup_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/activity_margin">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/elbowsup_status_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/elbowsup_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:alpha="0.8"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyButton
                    android:id="@+id/elbowsup_pause_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/elbowsup_setup_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/elbowsup_setup_label"
                    style="@style/SettingsSectionLabelStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/elbowsup_setup_label" />

                <LinearLayout
                    android:id="@+id/elbowsup_setup_screening_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="@dimen/medium_margin">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/elbowsup_setup_screening"
                        android:textSize="@dimen/normal_text_size" />

                    <org.fossify.commons.views.MyButton
                        android:id="@+id/elbowsup_setup_screening_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/elbowsup_setup_screening_button" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/elbowsup_setup_contacts_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="@dimen/medium_margin">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/elbowsup_setup_contacts"
                        android:textSize="@dimen/normal_text_size" />

                    <org.fossify.commons.views.MyButton
                        android:id="@+id/elbowsup_setup_contacts_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/elbowsup_setup_contacts_button" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/elbowsup_setup_dialer_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="@dimen/medium_margin">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/elbowsup_setup_dialer"
                        android:textSize="@dimen/normal_text_size" />

                    <org.fossify.commons.views.MyButton
                        android:id="@+id/elbowsup_setup_dialer_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/elbowsup_setup_dialer_button" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/elbowsup_rules_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/elbowsup_rules_label" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/elbowsup_rules_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/elbowsup_rules_empty"
                android:textSize="@dimen/normal_text_size" />

            <LinearLayout
                android:id="@+id/elbowsup_rules_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/elbowsup_add_rule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_margin"
                android:text="@string/elbowsup_add_rule" />

            <TextView
                android:id="@+id/elbowsup_schedules_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/elbowsup_schedules_label" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/elbowsup_schedules_explainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/elbowsup_schedules_explainer"
                android:textSize="@dimen/normal_text_size" />

            <LinearLayout
                android:id="@+id/elbowsup_schedules_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyButton
                android:id="@+id/elbowsup_add_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginBottom="@dimen/activity_margin"
                android:text="@string/elbowsup_add_schedule" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
